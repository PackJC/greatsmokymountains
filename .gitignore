# Generated files too big for GitHub (each is over its 100 MB file limit). They stay on disk, because
# tools/pack.py needs the world and navmesh to build the PBO, and the tools regenerate the rest (see each
# tool's header). Everything else the tools generate is committed.

# the binarized world (tools/build_world.py)
/greatsmokymountains.wrp

# the AI navmesh (generated in the DayZ tools)
/navmesh/*.nm

# the satellite images (tools/rebuild_layers.py, then tools/paint_roads.py) and the ASCII heightmap
# (tools/export_terrain.py; source/heightmap_16bit.png holds the same heights)
/source/satellite.png
/source/satellite_base.png
/source/heightmap.asc

# the tree list (tools/forest.py)
/source/forest/tb_trees.txt

# Python caches
__pycache__/
*.pyc
