# Generated by tools/ (see each tool's header for how to rebuild it). They stay on disk, because
# tools/pack.py needs the world, layers and navmesh to build the PBO, but they are too big for GitHub
# (over its 100 MB file limit, or gigabytes in all) and can be regenerated from what is committed.

# the binarized world (tools/build_world.py) and its terrain layer tiles
/greatsmokymountains.wrp
/data/layers/

# the AI navmesh (generated in the DayZ tools)
/navmesh/*.nm

# satellite and heightmap sources (tools/rebuild_layers.py, paint_roads.py, export_terrain.py)
/source/satellite.png
/source/satellite_base.png
/source/heightmap.asc
/source/heightmap_16bit.png

# Terrain Builder object lists and height caches (forest.py, buildings.py, osm_water.py, details.py ...)
/source/**/tb_*.txt
*.npy

# preview images the tools write next to their outputs
*preview*.png
*preview*.paa
*preview*.jpg

# Python caches
__pycache__/
*.pyc
